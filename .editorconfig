root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.cmake]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.{cpp,h,mm}]
indent_style = space
indent_size = 4

[*.{js,html,css}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4
